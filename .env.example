# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here

# Individual Database Names
AUTH_DB_NAME=fleetflow_auth
FLEET_DB_NAME=fleetflow_fleet
RENTAL_DB_NAME=fleetflow_rental
NOTIFICATION_DB_NAME=fleetflow_notifications

# JWT Configuration (for Identity and RBAC validation)
JWT_SECRET=your_jwt_super_secret_key_here
JWT_ISSUER=FleetFlow.IdentityService
JWT_AUDIENCE=FleetFlow.Client
JWT_EXPIRY_MINUTES=60

# Frontend Environment Variables (Vite client URLs)
VITE_IDENTITY_API_URL=http://localhost:5001
VITE_FLEET_API_URL=http://localhost:5002

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_VEHICLE_EVENTS_TOPIC=fleetflow.vehicle.events

# Future extraction destinations; the frontend does not use these until cutover.
VITE_RENTAL_API_URL=http://localhost:5003
VITE_NOTIFICATION_API_URL=http://localhost:5004

# Foundation internal authentication is opt-in. Generate separate private
# random values of >=32 bytes before enabling; never use the user JWT key.
SERVICE_AUTH_ENABLED=false
SERVICE_AUTH_SIGNING_KEY=
SERVICE_AUTH_RENTAL_SECRET=
SERVICE_AUTH_FLEET_SECRET=
SERVICE_AUTH_NOTIFICATION_SECRET=
INTERNAL_IDENTITY_URL=http://localhost:5001/
