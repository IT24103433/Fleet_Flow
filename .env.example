# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here

# Individual Database Names
AUTH_DB_NAME=fleetflow_auth
FLEET_DB_NAME=fleetflow_fleet

# JWT Configuration (for Identity and RBAC validation)
JWT_SECRET=your_jwt_super_secret_key_here
JWT_ISSUER=FleetFlowIdentity
JWT_AUDIENCE=FleetFlowServices
JWT_EXPIRY_MINUTES=60

# Frontend Environment Variables (Vite client URLs)
VITE_IDENTITY_API_URL=http://localhost:5001
VITE_FLEET_API_URL=http://localhost:5002

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_VEHICLE_EVENTS_TOPIC=fleetflow.vehicle.events
