# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here

# Individual Database Names
AUTH_DB_NAME=fleetflow_auth
FLEET_DB_NAME=fleetflow_fleet
RENTAL_DB_NAME=fleetflow_rental
NOTIFICATION_DB_NAME=fleetflow_notifications

# JWT Configuration (for Identity and RBAC validation)
JWT_SECRET=your_jwt_super_secret_key_here
JWT_ISSUER=FleetFlow.IdentityService
JWT_AUDIENCE=FleetFlow.Client
JWT_EXPIRY_MINUTES=60

# Local development API origins. Production builds require four public HTTPS
# origins; set them explicitly in CI/deployment, not these local defaults.
VITE_IDENTITY_API_URL=http://localhost:5001
VITE_FLEET_API_URL=http://localhost:5002

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_VEHICLE_EVENTS_TOPIC=fleetflow.vehicle.events

# All four services must complete guarded ownership activation before use.
VITE_RENTAL_API_URL=http://localhost:5003
VITE_NOTIFICATION_API_URL=http://localhost:5004

# Foundation internal authentication is opt-in. Generate separate private
# random values of >=32 bytes before enabling; never use the user JWT key.
SERVICE_AUTH_ENABLED=false
SERVICE_AUTH_SIGNING_KEY=
SERVICE_AUTH_RENTAL_SECRET=
SERVICE_AUTH_FLEET_SECRET=
SERVICE_AUTH_NOTIFICATION_SECRET=
INTERNAL_IDENTITY_URL=http://localhost:5001/

# Verified onboarding: activate only with the compatible four-service release.
# Generate separate private 32-byte base64 keys; leave secrets out of Git.
ONBOARDING_ENABLED=false
REQUIRE_DRIVER_VERIFICATION=false
EMAIL_ENABLED=false
ONBOARDING_DATA_KEY=
ONBOARDING_HASH_KEY=
EMAIL_DATA_KEY=
SERVICE_AUTH_IDENTITY_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_PUBLIC_URL=https://fleetflow-frontend.azurewebsites.net
IDENTITY_DOCUMENT_ROOT=
SMTP_USERNAME=fleetflow.automations@gmail.com
SMTP_PASSWORD=
SUPPORT_INBOX=fleetflow.automations@gmail.com
# Local review only. Never enable this restriction for public customer onboarding.
LOCAL_EMAIL_ALLOWLIST_REQUIRED=false
EMAIL_ALLOWLIST=

# Explicit notification cutover; keep Legacy/inactive until a verified import.
NOTIFICATION_OWNERSHIP=Legacy
INTERNAL_NOTIFICATION_URL=http://localhost:5004/
NOTIFICATION_SERVICE_ACTIVE=false
NOTIFICATION_MIGRATION_ID=

# Rental cutover is gated by a verified booking/ledger migration.
RENTAL_OWNERSHIP=Legacy
RENTAL_SERVICE_ACTIVE=false
RENTAL_MIGRATION_ID=
INTERNAL_RENTAL_URL=http://127.0.0.1:5003/
INTERNAL_FLEET_URL=http://127.0.0.1:5002/
