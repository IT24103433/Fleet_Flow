<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup><ItemGroup>
<ProjectReference Include="../../src/backend/services/RentalService/RentalService.Api/RentalService.Api.csproj" />
<ProjectReference Include="../../src/backend/services/FleetService/FleetService.Api/FleetService.Api.csproj" />
<ProjectReference Include="../ServiceDatabaseTool/ServiceDatabaseTool.csproj" />
<Content Include="../../src/backend/services/RentalService/RentalService.Api/Database/002_bookings.sql" Link="migrations/rental/002_bookings.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
