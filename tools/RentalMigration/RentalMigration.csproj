<!-- This offline console tool reads explicit environment settings only. API appsettings
     are not its configuration and collide when two API assemblies are referenced. -->
<Target Name="ExcludeApiHostSettings" BeforeTargets="_HandleFileConflictsForPublish">
 <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)' == 'appsettings' Or '%(ResolvedFileToPublish.Filename)' == 'appsettings.Development'" /></ItemGroup>
</Target></Project>
